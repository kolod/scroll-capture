<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>ScrollCapture</AssemblyName>
    <RootNamespace>ScrollCapture.App</RootNamespace>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <!-- 64-bit where possible: tall images need more than 2 GB of address space. -->
    <Prefer32Bit>false</Prefer32Bit>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <Version>1.0.0</Version>
    <Product>ScrollCapture</Product>
    <Description>Portable scrolling window capture utility</Description>
    <Copyright>Copyright © 2026 Oleksandr Kolodkin</Copyright>
    <!-- Single executable: never produce culture satellite folders. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <!-- Multi-size program icon for windows; built by tools/make-icon.ps1. -->
  <ItemGroup>
    <EmbeddedResource Include="app.ico" LogicalName="ScrollCapture.App.app.ico" />
  </ItemGroup>

  <!-- Core sources are compiled into the executable (no project reference, no DLL). -->
  <ItemGroup>
    <Compile Include="..\ScrollCapture.Core\**\*.cs"
             Exclude="..\ScrollCapture.Core\obj\**;..\ScrollCapture.Core\bin\**"
             Link="Core\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    All languages are embedded in the main assembly. WithCulture="false" stops MSBuild
    from turning culture-suffixed .resx files into satellite assemblies.
  -->
  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings.resx" WithCulture="false" LogicalName="ScrollCapture.Strings.en.resources" />
    <EmbeddedResource Update="Resources\Strings.uk.resx" WithCulture="false" LogicalName="ScrollCapture.Strings.uk.resources" />
  </ItemGroup>

</Project>
